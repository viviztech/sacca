APP_NAME=Sacca
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.laravel.cloud

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database — injected automatically by Laravel Cloud (MySQL or Postgres)
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Session — use Redis (injected by Laravel Cloud)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Storage — use S3-compatible object storage (Cloudflare R2 via Laravel Cloud)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Queue — use Redis (injected by Laravel Cloud)
QUEUE_CONNECTION=redis

# Cache — use Redis (injected by Laravel Cloud)
CACHE_STORE=redis

# Redis — injected automatically by Laravel Cloud
REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

# Mail
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@sacca.in"
MAIL_FROM_NAME="Sacca Institute"

# WhatsApp (existing Meta Cloud API service)
WHATSAPP_API_URL=http://localhost:8003/api

# Firebase FCM
FIREBASE_CREDENTIALS=

VITE_APP_NAME="${APP_NAME}"
